# --- TensorRT engines (built per-device on Jetson) ---
*.engine

# --- Large model weights (manage separately if needed) ---
*.pt
*.pth
!models/yolov8n.pt

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/

# --- Logs (keep folder via .gitkeep, ignore contents) ---
logs/*
!logs/.gitkeep

# --- Results: ignore intermediates, keep final deliverables ---
results/*
!results/comparison_drop_only_h264.mp4
!results/comparison_full_h264.mp4
!results/comparison_original_h264.mp4

!results/patch_sizes.csv
!results/experiments.md

# --- Data: ignore raw clips, keep minimal samples ---
data/*
!data/test_images/
data/test_images/*
!data/test